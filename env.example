# --- Global Settings ---
# See https://docs.linuxserver.io/general/understanding-puid-and-pgid
PUID=1000
PGID=1000
TZ=America/New_York

# --- Shared Media Paths ---
# This can be a single downloads folder shared by all apps
DOWNLOADS_DIR=/path/to/your/data/downloads

# --- Prowlarr ---
PROWLARR_CONFIG_DIR=/path/to/your/configs/prowlarr

# --- qBittorrent ---
QBITTORRENT_CONFIG_DIR=/path/to/your/configs/qbittorrent

# --- Sonarr (TV Shows) ---
SONARR_CONFIG_DIR=/path/to/your/configs/sonarr
SONARR_TV_DIR=/path/to/your/data/tv

# --- Radarr (Movies) ---
RADARR_CONFIG_DIR=/path/to/your/configs/radarr
RADARR_MOVIES_DIR=/path/to/your/data/movies

# --- Lidarr (Music) ---
LIDARR_CONFIG_DIR=/path/to/your/configs/lidarr
LIDARR_MUSIC_DIR=/path/to/your/data/music

# --- Jellyfin ---
JELLYFIN_CONFIG_DIR=/path/to/your/configs/jellyfin
JELLYFIN_TV_DIR=/path/to/your/data/tv
JELLYFIN_MOVIES_DIR=/path/to/your/data/movies
JELLYFIN_CACHE_DIR=/path/to/your/configs/jellyfin/cache

# --- Navidrome ---
NAVIDROME_CONFIG_DIR=/path/to/your/configs/navidrome
NAVIDROME_MUSIC_DIR=/path/to/your/data/music

# --- Immich Settings ---
IMMICH_UPLOAD_LOCATION=/path/to/your/photos
IMMICH_DB_DATA_LOCATION=/path/to/your/configs/immich/postgres
IMMICH_MODEL_CACHE_DIR=/path/to/your/configs/immich/model-cache
DB_USERNAME=immich
DB_PASSWORD=changeme