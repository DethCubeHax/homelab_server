# --- Global Settings ---
# See https://docs.linuxserver.io/general/understanding-puid-and-pgid
PUID=1000
PGID=1000
TZ=America/New_York

# --- Shared Media Paths ---
# This can be a single downloads folder shared by all apps
DOWNLOADS_DIR=/path/to/your/data/downloads

# --- Prowlarr ---
PROWLARR_CONFIG_DIR=/path/to/your/configs/prowlarr

# --- qBittorrent ---
QBITTORRENT_CONFIG_DIR=/path/to/your/configs/qbittorrent

# --- Sonarr (TV Shows) ---
SONARR_CONFIG_DIR=/path/to/your/configs/sonarr
SONARR_TV_DIR=/path/to/your/data/tv

# --- Radarr (Movies) ---
RADARR_CONFIG_DIR=/path/to/your/configs/radarr
RADARR_MOVIES_DIR=/path/to/your/data/movies

# --- Lidarr (Music) ---
LIDARR_CONFIG_DIR=/path/to/your/configs/lidarr
LIDARR_MUSIC_DIR=/path/to/your/data/music

# --- Jellyfin ---
JELLYFIN_CONFIG_DIR=/path/to/your/configs/jellyfin
JELLYFIN_TV_DIR=/path/to/your/data/tv
JELLYFIN_MOVIES_DIR=/path/to/your/data/movies
JELLYFIN_CACHE_DIR=/path/to/your/configs/jellyfin/cache

# --- Navidrome ---
NAVIDROME_CONFIG_DIR=/path/to/your/configs/navidrome
NAVIDROME_MUSIC_DIR=/path/to/your/data/music

# --- Immich Settings ---
# Required when Immich is served at https://photos.example.com via Caddy/Cloudflare Tunnel
IMMICH_SERVER_URL=https://photos.example.com
IMMICH_UPLOAD_LOCATION=/path/to/your/photos
IMMICH_DB_DATA_LOCATION=/path/to/your/configs/immich/postgres
IMMICH_MODEL_CACHE_DIR=/path/to/your/configs/immich/model-cache
DB_USERNAME=immich
DB_PASSWORD=changeme

# --- Nextcloud ---
NEXTCLOUD_DOMAIN=cloud.example.com
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_BEFORE_START
NEXTCLOUD_DB_PASSWORD=changeme-generate-with-openssl-rand-hex-24
NEXTCLOUD_HTML_DIR=/mnt/Data/Plex_Config/nextcloud/html
NEXTCLOUD_DATA_DIR=/mnt/Data/Cloud/nextcloud/data
NEXTCLOUD_DB_DATA_LOCATION=/mnt/Data/Plex_Config/nextcloud/postgres

# --- Monitoring (Grafana + Loki + Prometheus on /mnt/Data SSD) ---
MONITORING_DIR=/mnt/Data/monitoring
# Grafana admin password — only service with a login
MONITORING_PASSWORD=changeme
# Admin email (used for alerts; login username is usually this email)
MONITORING_ADMIN_EMAIL=you@example.com
# After changing MONITORING_PASSWORD, run: ./monitoring/scripts/update-monitoring-auth.sh

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-from-cloudflare-dashboard

# --- Matrix (Synapse) ---
SYNAPSE_CONFIG_DIR=/path/to/your/configs/synapse
SYNAPSE_DB_DATA_LOCATION=/path/to/your/configs/synapse/postgres
SYNAPSE_DB_PASSWORD=changeme

# --- Cloudflare TURN (matrix-turnify) ---
# Create a TURN key: Cloudflare Dashboard → Realtime → TURN → Create
CF_TURN_TOKEN_ID=your-turn-key-id
CF_TURN_API_TOKEN=your-turn-api-token
TURN_CREDENTIAL_TTL_SECONDS=86400

# --- Matrix maintenance scripts (optional) ---
# Used by matrix/scripts/fix-family-room.py
MATRIX_FIX_USER=your-matrix-localpart
MATRIX_FIX_PASSWORD=your-matrix-password
MATRIX_FIX_ROOM_ID=!roomid:example.com

# --- MatrixRTC (Element X / Element Call) ---
MATRIX_SERVER_NAME=example.com
MATRIX_RTC_HOST=rtc.example.com
# Must match keys: in matrix/livekit/livekit.yaml (copy from livekit.yaml.example)
LIVEKIT_API_KEY=changeme-generate-with-openssl-rand-hex-12
LIVEKIT_API_SECRET=changeme-generate-with-openssl-rand-hex-32