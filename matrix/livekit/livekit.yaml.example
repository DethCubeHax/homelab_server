port: 7880
bind_addresses:
  - "0.0.0.0"

rtc:
  tcp_port: 7881
  port_range_start: 50100
  port_range_end: 50200
  use_external_ip: false

room:
  auto_create: false

logging:
  level: info

# Embedded TURN relays media when UDP to the SFU is blocked (no port forward).
# Expose tls_port 5349 through Cloudflare Tunnel as a TCP route.
turn:
  enabled: true
  domain: matrix.example.com
  cert_file: /certs/tls.crt
  key_file: /certs/tls.key
  tls_port: 5349
  udp_port: 3478
  external_tls: true

webhook:
  api_key: YOUR_LIVEKIT_API_KEY
  urls:
    - http://lk-jwt-service:8080/sfu_webhook

keys:
  YOUR_LIVEKIT_API_KEY: YOUR_LIVEKIT_API_SECRET
